# db2
DB2_SYSTEM = '10.0.0.220'
DB2_UID = ''
DB2_PWD = ''
DB2_SCHEMA = 'MSCONV'
# DB2 timezone-offset cache TTL in ms; defaults to 1 hour.
DB2_TIMEZONE_OFFSET_TTL_MS = 3600000

# db2 (integration tests only)
# Used only by integration tests; leave empty to skip. Prefer a SELECT-only user;
# the harness also opens the connection with ConnectionType=2 (read-only).
DB2_TEST_SYSTEM = ''
DB2_TEST_UID = ''
DB2_TEST_PWD = ''
DB2_TEST_SCHEMA = 'MSCONV'

# broker
RMQ_USER='admin'
RMQ_PASS='password'
RMQ_HOST = 'host.docker.internal:5672'

# cache
# Named TTL tiers, ms. Callers pick a tier by intent (see caching.config.ts).
# DEFAULT: general/volatile (1 min). LONG: rarely-changed reference data (1 h).
# LONGER: stable/expensive verdicts (7 d).
CACHE_DEFAULT_TTL_MS = 60000
CACHE_LONG_TTL_MS = 3600000
CACHE_LONGER_TTL_MS = 604800000

# request throttler
THROTTLER_GLOBAL_SPAN = 60000
THROTTLER_GLOBAL_LIMIT = 2000

# Tighter tier for conversation write endpoints (create / reply); wired by the feature spec.
THROTTLER_WORKFLOW_SPAN = 60000
THROTTLER_WORKFLOW_LIMIT = 1000

# app
APP_ID = 'ms-conversations'
DEPLOY_ENV=          # deployment identity: DEV | UAT | STAGING | PROD

# Expose Swagger at /api only when set to 'true'; independent of ENV_PRODUCTION.
SWAGGER_ENABLED = 'false'

# --- Conversations (domain) — wired by the virtual-agent-quote feature spec ---
# Base URL of ms-messaging, used to delegate notification emails (ticket -> messaging, fire-and-forget).
MESSAGING_BASE_URL = 'http://host.docker.internal:6113'
# Public base URL the tokenized customer conversation link points at.
CONVERSATION_FRONTEND_URL = 'http://localhost:3000/conversations'

# --- Cron (scheduled jobs) ---
# Only "true" allows cron commands to initialize Nest, DB2, and RabbitMQ.
CRON_ENABLED = 'false'

# Comma-separated list of job names to run in this environment (e.g. "example-sweep").
# Empty or unset → nothing runs even when CRON_ENABLED=true (pure opt-in).
CRON_JOBS=

# Sweep page size; defaults to 500.
CRON_SCAN_BATCH_SIZE = 500

# --- Logging ---

# Defaults to <cwd>/logs.
LOG_DIR=

# Leave empty for one instance. Multi-instance deployments must inject a stable,
# unique value per writer because pino-roll cannot coordinate a shared file.
INSTANCE_ID=

# --- Alerting (Teams) ---

# Comma-separated webhook URLs. Leave empty for logs-only alerting; treat as secret.
TEAMS_ALERT_WEBHOOK_URL=

# Per-(level + message) alert limit within the window.
ALERT_THROTTLE_WINDOW_MS=60000
ALERT_THROTTLE_MAX=1
