{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../src",
  "testEnvironment": "node",
  "testRegex": ".*\\.integration-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/$1",
    "^@test/(.*)$": "<rootDir>/../test/$1"
  },
  "clearMocks": true,
  "restoreMocks": true,
  "setupFiles": ["<rootDir>/../test/setup-integration.ts"]
}
